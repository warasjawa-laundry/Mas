# Stage 3 owner authentication. Server-side only: do not prefix these with NEXT_PUBLIC_.
# Configure per PREVIEW environment, not production, until Stage 3 passes QA.
SUPABASE_URL=https://hncfyfvqtlnvqyfrydzb.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
OWNER_LOGIN_ID=masjawalaundry
# Supabase Auth requires a server-side email/phone identity; owner NEVER types email.
# Provision the Auth identity through the Supabase Dashboard (Admin only).
OWNER_AUTH_EMAIL=replace-with-owner-auth-identity@example.com

# Stage 2: keep feature disabled until printing/QR/member portal pass release testing.
NEXT_PUBLIC_MEMBERSHIP_LAUNCHED=false

# Stage 4: 32 bytes randomly generated and base64-encoded, PREVIEW ONLY. Never commit real key.
LAUNDRY_CARD_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Optional: unyil Vercel Preview only. Navigates public pages to the stable
