# Server-side settings. Never prefix these names with NEXT_PUBLIC_.
# Local development and every Vercel Preview branch use the clean synthetic QA project.
LAUNDRY_DATABASE_MODE=qa
QA_BRANCH_ISOLATION=cwxsbgfjynwxqalwonae
SUPABASE_URL=https://cwxsbgfjynwxqalwonae.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-qa-project-publishable-key
OWNER_LOGIN_ID=masjawalaundry
# Supabase Auth requires a server-side email/phone identity; owner NEVER types email.
# Provision the synthetic QA Auth identity through the Supabase Dashboard (Admin only).
OWNER_AUTH_EMAIL=replace-with-qa-auth-identity@example.com

# QA uses a separate 32-byte base64 key; never copy an operational encryption key.
LAUNDRY_CARD_ENCRYPTION_KEY_QA=replace-with-independent-qa-32-byte-base64-key
# Set the observed branch alias from the actual QA deployment, without a trailing slash.
# Only owned mas-git-* aliases are accepted; main and retired QA aliases are rejected.
QA_CARD_ORIGIN=replace-with-observed-qa-branch-https-origin
# Missing QA key/origin disables issuance. Operational/legacy keys are never QA fallbacks.

# Production only: keep the existing operational public key and encryption keys.
# SUPABASE_URL=https://hncfyfvqtlnvqyfrydzb.supabase.co
# SUPABASE_PUBLISHABLE_KEY=existing-operational-public-key
# LAUNDRY_DATABASE_MODE=single
# Remove QA_BRANCH_ISOLATION in Production. Test runners must never use operational credentials.
# Vercel production builds set VERCEL=1 and CI=1; this platform build context is supported.
# Explicit test commands must set LAUNDRY_TEST_RUNNER=1; GitHub Actions is detected automatically.
# These test markers override Vercel metadata; generic CI also rejects operational credentials.
# LAUNDRY_CARD_ENCRYPTION_KEY_OPERATIONAL=existing-operational-primary-key
# LAUNDRY_CARD_ENCRYPTION_KEY=existing-legacy-card-key
# Replacing card keys without reissuing cards prevents old cards from being decrypted.

# Both legacy anon and modern publishable keys require reviewed source-pinned hashes.
# A key rotation needs a registry update in lib/supabase/qa-preview-isolation.ts.
# Preview rejects service-role/secret keys, extra Supabase aliases and direct DB settings.
# Public builds without database settings remain available; this guard is not a network firewall.

# Optional features remain disabled unless explicitly enabled for a reviewed release.
OWNER_CARD_REISSUE_ENABLED=0
OWNER_POINT_YEAR_SETUP_ENABLED=0

# Optional: unyil Vercel Preview only. Navigates public pages to the stable
# review branch alias instead of a one-off immutable deployment hostname.
# Never enable this on Netlify or official Production.
# REVIEW_NAV_ORIGIN=https://mas-git-main-m8traders-projects-081d9dc2.vercel.app
